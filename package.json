{
  "name": "remote-access-mcp",
  "version": "4.6.9",
  "description": "Turn any laptop, desktop, VM, or server into a secure AI-agent workspace via MCP. Let ChatGPT, Claude, Grok, Qwen and other MCP clients read and edit files, run commands, test code, inspect systems, and complete real-world tasks.",
  "type": "module",
  "bin": {
    "remote-access-mcp": "dist/main.js",
    "ramcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.fa.md",
    "README.zh-CN.md",
    "README.tr.md",
    "README.ru.md",
    "README.ar.md",
    "LICENSE",
    "install.sh",
    "AGENTS.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/ai"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-plugin-sandbox.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mcp-gateway",
    "model-context-protocol",
    "ai-agent",
    "agentic-ai",
    "ai-ops",
    "computer-use",
    "coding-agent",
    "remote-access",
    "server-management",
    "developer-tools",
    "infrastructure",
    "devops",
    "self-hosted",
    "linux",
    "macos",
    "windows",
    "chatgpt",
    "claude",
    "grok",
    "qwen"
  ],
  "author": "Amir Ali Manzar (https://amiralimanzar.ir)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirAliManzar/remote-access-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/AmirAliManzar/remote-access-mcp/issues"
  },
  "homepage": "https://github.com/AmirAliManzar/remote-access-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^11.6.0",
    "blessed": "^0.1.81",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "@upstash/context7-mcp": "^4.0.4",
    "codebase-memory-mcp": "^0.10.8",
    "context-mode": "^1.0.169"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/blessed": "^0.1.25",
    "@types/express": "^4.17.21",
    "@types/node": "^26.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "codebase-memory-mcp@0.10.8": true,
    "context-mode@1.0.169": true,
    "better-sqlite3@11.10.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "overrides": {
    "qs": ">=6.16.0"
  }
}
